      <data key="nagarik_app">false</data>
      <data key="required_documents">N/A</data>
    </node>
    <node id="report_corruption_bribe">
      <data key="name">Report Corruption and Abuse of Office</data>
      <data key="type">service</data>
      <data key="category">Anti-Corruption &amp; Vigilance</data>
      <data key="description">Online form and toll-free helpline to register corruption allegations, bribery complaints, and submit supporting evidence.</data>
      <data key="digitized_status">Fully Online</data>
      <data key="nagarik_app">false</data>
      <data key="required_documents">Evidence documents/media (optional);Complaint letter</data>
    </node>
    <node id="hello_sarkar">
      <data key="name">Hello Sarkar Public Grievance Portal</data>
      <data key="type">department</data>
      <data key="category">Governance &amp; Administration</data>
      <data key="description">Public grievance redressal system directly monitored by the OPMCM to address citizen complaints.</data>
      <data key="digitized_status">Fully Online</data>
      <data key="nagarik_app">false</data>
      <data key="required_documents">N/A</data>
    </node>
    <node id="register_grievance">
      <data key="name">Lodge Citizen Grievance</data>
      <data key="type">service</data>
      <data key="category">Governance &amp; Administration</data>
      <data key="description">Lodge complaints against public agencies, officials, delayed services, or infrastructure issues via web, SMS, phone, or app.</data>
      <data key="digitized_status">Fully Online</data>
      <data key="nagarik_app">true</data>
      <data key="required_documents">Details of the grievance;Supporting files/photos (optional)</data>
    </node>
    <node id="track_grievance">
      <data key="name">Track Grievance Status</data>
      <data key="type">service</data>
      <data key="category">Governance &amp; Administration</data>
      <data key="description">Track the action taken on registered complaints using a unique token identifier.</data>
      <data key="digitized_status">Fully Online</data>
      <data key="nagarik_app">true</data>
      <data key="required_documents">Complaint Token ID</data>

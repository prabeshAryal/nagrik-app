<?xml version="1.0" ?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="name" for="node" attr.name="name" attr.type="string"/>
  <key id="type" for="node" attr.name="type" attr.type="string"/>
  <key id="category" for="node" attr.name="category" attr.type="string"/>
  <key id="description" for="node" attr.name="description" attr.type="string"/>
  <key id="digitized_status" for="node" attr.name="digitized_status" attr.type="string"/>
  <key id="nagarik_app" for="node" attr.name="nagarik_app" attr.type="boolean"/>
  <key id="required_documents" for="node" attr.name="required_documents" attr.type="string"/>
  <graph id="G" edgedefault="directed">
    <node id="opmcm">
      <data key="name">Office of the Prime Minister and Council of Ministers</data>
      <data key="type">root</data>
      <data key="category">Governance &amp; Administration</data>
      <data key="description">Central executive office coordinating the cabinet, formulating national policies, and overseeing all ministries.</data>
      <data key="digitized_status">Partially Online</data>
      <data key="nagarik_app">false</data>
      <data key="required_documents">N/A</data>
    </node>
    <node id="psc">
      <data key="name">Public Service Commission (Lok Sewa Aayog)</data>
      <data key="type">constitutional_body</data>
      <data key="category">Public Recruitment</data>
      <data key="description">Constitutional body responsible for conducting recruitment examinations and appointing civil servants.</data>
      <data key="digitized_status">Fully Online</data>
      <data key="nagarik_app">false</data>
      <data key="required_documents">N/A</data>
    </node>
    <node id="lok_sewa_job_application">
      <data key="name">Lok Sewa Job Application &amp; Registration</data>
      <data key="type">service</data>
      <data key="category">Employment &amp; Recruitment</data>
      <data key="description">Online registration, application submission, and fee payment for federal civil service examinations.</data>
      <data key="digitized_status">Fully Online</data>
      <data key="nagarik_app">true</data>
      <data key="required_documents">Citizenship;Academic Certificates;Character Certificate;Passport Photo;Signature Scan</data>
    </node>
    <node id="lok_sewa_exam_schedule_results">
      <data key="name">Civil Service Exam Schedule and Results Portal</data>
      <data key="type">service</data>
      <data key="category">Employment &amp; Recruitment</data>
      <data key="description">Public portal for checking examination dates, roll numbers, syllabus, written results, and interview calls.</data>
      <data key="digitized_status">Fully Online</data>
      <data key="nagarik_app">true</data>
      <data key="required_documents">None</data>
    </node>
    <node id="ecn">
      <data key="name">Election Commission Nepal</data>
      <data key="type">constitutional_body</data>
      <data key="category">Democracy &amp; Elections</data>
      <data key="description">Constitutional body that manages voter registration, conducts federal/provincial/local elections, and regulates political parties.</data>
      <data key="digitized_status">Partially Online</data>
      <data key="nagarik_app">false</data>
      <data key="required_documents">N/A</data>
    </node>
    <node id="voter_registration_biometrics">
      <data key="name">Voter Registration with Biometrics</data>
      <data key="type">service</data>
      <data key="category">Democracy &amp; Elections</data>
      <data key="description">Pre-registration of voting details online, followed by biometric (fingerprint/photo) collection at district offices.</data>
      <data key="digitized_status">Partially Online</data>
      <data key="nagarik_app">false</data>
      <data key="required_documents">Citizenship Certificate;Proof of Address (if different from citizenship)</data>
    </node>
    <node id="check_voter_card_details">
      <data key="name">Check Voter Card Details &amp; Polling Center</data>
      <data key="type">service</data>
      <data key="category">Democracy &amp; Elections</data>
